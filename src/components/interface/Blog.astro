<section class="py-32" id="Blog">
    <div
        class="container mx-auto px-4 flex flex-col gap-8 lg:flex-row lg:gap-16"
    >
        <div class="grid gap-x-4 gap-y-8 md:grid-cols-2 lg:gap-x-6 lg:gap-y-12">
            {
                posts.map((post) => (
                    <a href={`/blog/${post.slug}`} class="group flex flex-col">
                        <div class="mb-4 flex overflow-clip rounded-xl md:mb-5">
                            <div class="transition duration-300 group-hover:scale-105">
